import { ScrollView, Palette } from "std-widgets.slint";
import { Atelier, ActionButton, Field, Eyebrow, PageHeading, StatusDot, NoteEditor } from "atelier.slint";
import { ClassesPage, ClassNotesPage, ClassNoteItem, QueueNoteItem, ClassTileData, TileRow, NoteData, QueueData, HistoryData, WebResultData } from "classes-page.slint";
import { SettingsPage } from "settings-page.slint";
import { Page } from "types.slint";

component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <image> glyph;
    in property <bool> active;
    in property <int> badge;
    callback clicked();
    height: 48px; border-radius: 10px;
    background: root.active ? #22261f : (nav-touch.has-hover ? #191c19 : transparent);
    animate background { duration: 170ms; }
    nav-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout { padding-left: 16px; padding-right: 14px; spacing: 12px;
        Rectangle { width: 18px; Image { source: root.glyph; width: 18px; height: 18px; y: (parent.height - self.height) / 2; colorize: root.active ? Atelier.gold : Atelier.dim; } }
        Text { text: root.label; color: root.active ? Atelier.gold : Atelier.muted; font-size: 13px; font-weight: root.active ? 600 : 400; vertical-alignment: center; horizontal-stretch: 1; }
        if root.badge > 0: Rectangle { width: 24px; Rectangle { width: 24px; height: 24px; y: (parent.height - self.height) / 2; border-radius: 12px; background: Atelier.gold; Text { text: root.badge > 99 ? "99+" : "\{root.badge}"; color: #24271f; font-size: 10px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; } } }
    }
}

export component AppWindow inherits Window {
    title: "Notes AI · Your private atelier";
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    icon: @image-url("./icon-removebg-preview.png");
    background: Atelier.canvas;
    preferred-width: 1180px; preferred-height: 820px;
    min-width: 940px; min-height: 720px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    in-out property <Page> current-page: Page.Main;
    in-out property <string> selected-class;
    in-out property <[TileRow]> rows;
    in-out property <[NoteData]> class-notes;
    in-out property <bool> notes-newest-first: true;
    in-out property <bool> classification-web: true;
    in-out property <string> ai-progress;
    callback sort-notes();
    in-out property <[QueueData]> main-notes;
    in-out property <[HistoryData]> filed-history;
    in-out property <string> collection-draft;
    in-out property <bool> use-laya;
    in-out property <bool> laya-fallback: true;
    callback create-collection(string);
    callback open-filed-note(int);
    in-out property <[NoteData]> search-results;
    in-out property <[WebResultData]> web-results;
    in-out property <int> new-total;
    in-out property <int> note-total;
    in-out property <int> category-total;
    in-out property <bool> llm-running;
    in-out property <string> llm-status: "Connecting to Ollama";
    in-out property <string> last-saved-category;
    in-out property <string> last-saved-text;
    in-out property <int> last-saved-id;
    in-out property <bool> notice-visible;
    in-out property <bool> search-busy;
    in-out property <string> search-message;
    in-out property <string> query;
    in-out property <bool> web-mode;
    in-out property <string> draft;
    in-out property <string> class-draft;

    callback delete-class-note(int);
    callback add-class-note(string, string);
    callback class-opened(string);
    callback delete-class-wrapper(string);
    callback add-main-note(string);
    callback delete-main-note(int);
    callback rename-class-wrapper(string, string);
    callback on-semantic-search-wrapper(string);
    callback web-search(string);
    callback cancel-search();
    callback open-web-result(int);
    callback save-web-result(int);
    callback open-browser-search();
    callback open-last-note();

    in-out property <string> alert-message;
    in-out property <bool> alert-visible;
    in-out property <bool> alert-success;
    Timer { interval: 2800ms; running: root.alert-visible && root.alert-success; triggered => { root.alert-visible = false; } }
    in-out property <string> llm-model;
    in-out property <string> embeddings-model;
    in-out property <int> search-limit;
    in-out property <bool> sync-enabled;
    in-out property <string> sync-port: "8743";
    in-out property <bool> sync-running;
    in-out property <string> sync-status;
    in-out property <string> sync-devices;
    in-out property <string> sync-token;
    in-out property <image> sync-qr;
    in-out property <string> sync-address;
    callback reset-sync-pairing();
    callback save-settings();
    callback import-requested();
    callback import-confirmed();
    callback import-cancelled();
    callback export-data(string);
    in-out property <string> import-preview;
    in-out property <bool> import-confirmation;
    in-out property <string> transfer-status;

    function search-now() {
        if root.query != "" {
            if root.web-mode { root.web-search(root.query); }
            else { root.on-semantic-search-wrapper(root.query); }
        }
    }

    HorizontalLayout { spacing: 0;
        Rectangle { width: 222px; background: Atelier.sidebar;
            VerticalLayout { padding: 20px; padding-top: 36px; spacing: 8px;
                HorizontalLayout { height: 48px; spacing: 12px;
                    Rectangle { width: 38px; height: 42px; border-radius: 10px; border-width: 1px; border-color: #655a43;
                        Text { text: "N"; font-family: "Georgia"; font-size: 28px; color: Atelier.gold; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout { spacing: 2px; alignment: center;
                        Text { text: "Notes AI"; font-family: "Georgia"; font-size: 22px; color: Atelier.ink; }
                        Text { text: "THE PRIVATE ATELIER"; color: Atelier.dim; font-size: 7px; letter-spacing: 1.5px; }
                    }
                }
                Rectangle { height: 38px; }
                Eyebrow { text: "WORKSPACE"; color: Atelier.dim; font-size: 8px; }
                Rectangle { height: 8px; }
                NavigationItem { label: "Capture"; glyph: @image-url("icons/capture.svg"); active: root.current-page == Page.Main; clicked => { root.current-page = Page.Main; } }
                NavigationItem { label: "Library"; glyph: @image-url("icons/library.svg"); active: root.current-page == Page.Classes || root.current-page == Page.ClassDetail; badge: root.new-total; clicked => { root.current-page = Page.Classes; } }
                NavigationItem { label: "Discover"; glyph: @image-url("icons/discover.svg"); active: root.current-page == Page.SearchResults; clicked => { root.current-page = Page.SearchResults; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: 1px; background: Atelier.border; }
                NavigationItem { label: "Preferences"; glyph: @image-url("icons/settings.svg"); active: root.current-page == Page.Settings; clicked => { root.current-page = Page.Settings; } }
                Rectangle { height: 14px; }
                HorizontalLayout { height: 22px; spacing: 8px; StatusDot { online: root.llm-running; } Text { text: root.llm-status; color: Atelier.muted; font-size: 10px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; } }
                HorizontalLayout { height: 22px; spacing: 8px; StatusDot { online: root.sync-running; } Text { text: root.sync-running ? "Phone sync available" : "Phone sync offline"; color: Atelier.dim; font-size: 10px; horizontal-stretch: 1; vertical-alignment: center; } }
                Text { text: "YOURS. QUIETLY INTELLIGENT."; color: #505b52; font-size: 7px; letter-spacing: 1px; height: 30px; vertical-alignment: bottom; }
            }
        }
        Rectangle { width: 1px; background: Atelier.border; }
        VerticalLayout { padding-left: 36px; padding-right: 36px; padding-top: 27px; padding-bottom: 28px; spacing: 24px;
            HorizontalLayout { height: 28px;
                Eyebrow { text: root.current-page == Page.Settings ? "PREFERENCES" : (root.current-page == Page.SearchResults ? "DISCOVER" : "PERSONAL WORKSPACE"); color: Atelier.dim; font-size: 8px; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: "\{root.note-total} notes   /   \{root.category-total} collections"; color: Atelier.dim; font-size: 10px; vertical-alignment: center; }
            }
            Rectangle { height: 1px; background: Atelier.border; }

            if root.current-page == Page.Main: VerticalLayout { spacing: 14px; vertical-stretch: 1;
                VerticalLayout { spacing: 10px;
                    Eyebrow { text: "ROOM FOR YOUR NEXT GREAT THOUGHT"; }
                    PageHeading { text: "Clear your mind."; font-size: 46px; }
                    Text { text: "Capture a thought. Let AI find its place."; color: Atelier.muted; font-size: 14px; }
                }
                Rectangle { height: 178px; border-radius: 16px; background: Atelier.surface; border-width: 1px; border-color: compose.has-focus ? #796c50 : Atelier.border;
                    VerticalLayout { padding: 20px; spacing: 14px;
                        HorizontalLayout { height: 16px; Eyebrow { text: "A NEW NOTE"; color: Atelier.dim; font-size: 8px; horizontal-stretch: 1; } Text { text: "PRIVATE BY DEFAULT"; color: Atelier.dim; font-size: 8px; letter-spacing: 1px; } }
                        compose := NoteEditor { text <=> root.draft; placeholder: "An idea, a recommendation, something worth keeping…"; vertical-stretch: 1;
                            capture => { if root.draft != "" { root.add-main-note(root.draft); } }
                        }
                        HorizontalLayout { height: 40px;
                            Text { text: "Enter to capture · Shift + Enter for a new line"; color: Atelier.dim; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
                            ActionButton { label: "Capture note  ↗"; primary: true; available: root.draft != ""; clicked => { root.add-main-note(root.draft); } }
                        }
                    }
                }
                if root.filed-history.length > 0: VerticalLayout { spacing: 10px; vertical-stretch: 0;
                    Eyebrow { text: "ИСТОРИЯ"; color: Atelier.green; font-size: 11px; height: 20px; }
                    history-scroll := ScrollView { height: 260px;
                        VerticalLayout { width: history-scroll.visible-width; spacing: 6px;
                            for item in root.filed-history: Rectangle { height: 48px; border-radius: 8px; background: #1b241e;
                                HorizontalLayout { padding: 10px; spacing: 12px;
                                    Text { text: item.text; color: Atelier.ink; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: "→  " + item.category; color: Atelier.gold; font-size: 11px; width: 190px; overflow: elide; vertical-alignment: center; }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.open-filed-note(item.id); } }
                            }
                        }
                    }
                }
                HorizontalLayout { height: 24px; Eyebrow { text: "AWAITING THEIR PLACE"; color: Atelier.muted; horizontal-stretch: 1; } Text { text: "\{root.main-notes.length} in queue"; color: Atelier.dim; font-size: 11px; } }
                queue-scroll := ScrollView { vertical-stretch: 1;
                    VerticalLayout { width: queue-scroll.visible-width; spacing: 10px;
                        if root.main-notes.length == 0: Rectangle { height: 104px; border-radius: 12px; border-width: 1px; border-color: Atelier.border;
                            VerticalLayout { alignment: center; spacing: 8px; Text { text: "A clear desk. A clear mind."; color: Atelier.ink; font-family: "Georgia"; font-size: 22px; horizontal-alignment: center; } Text { text: "New notes appear here while AI finds the right collection."; color: Atelier.dim; font-size: 12px; horizontal-alignment: center; } }
                        }
                        for note in root.main-notes: QueueNoteItem { note-text: note.text; status: note.status; active: note.active; delete-note => { root.delete-main-note(note.id); } }
                    }
                }
            }

            if root.current-page == Page.Classes: ClassesPage { vertical-stretch: 1; rows: root.rows; new-total: root.new-total;
                collection-draft <=> root.collection-draft;
                create-collection(name) => { root.create-collection(name); }
                class-selected(name) => { root.selected-class = name; root.current-page = Page.ClassDetail; root.class-opened(name); }
            }
            if root.current-page == Page.ClassDetail: ClassNotesPage { vertical-stretch: 1; class-name: root.selected-class; notes: root.class-notes; draft <=> root.class-draft;
                newest-first: root.notes-newest-first;
                sort-notes => { root.notes-newest-first = !root.notes-newest-first; root.sort-notes(); }
                go-back => { root.current-page = Page.Classes; }
                delete-note(id) => { root.delete-class-note(id); }
                add-note(text) => { root.add-class-note(text, root.selected-class); }
                delete-class(name) => { root.delete-class-wrapper(name); }
                rename-class(name) => { root.rename-class-wrapper(root.selected-class, name); }
            }

            if root.current-page == Page.SearchResults: VerticalLayout { spacing: 18px; vertical-stretch: 1;
                Eyebrow { text: "FOLLOW YOUR CURIOSITY"; }
                PageHeading { text: "Find your next connection."; }
                HorizontalLayout { height: 40px; spacing: 8px;
                    ActionButton { label: "My notes"; primary: !root.web-mode; clicked => { root.cancel-search(); root.web-mode = false; root.search-message = ""; root.search-busy = false; } }
                    ActionButton { label: "The web"; primary: root.web-mode; clicked => { root.cancel-search(); root.web-mode = true; root.search-message = ""; root.search-busy = false; } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.web-mode ? "POWERED BY DUCKDUCKGO" : "SEMANTIC SEARCH · OLLAMA"; font-size: 8px; letter-spacing: 1px; color: Atelier.dim; vertical-alignment: center; }
                }
                HorizontalLayout { spacing: 12px;
                    Field { text <=> root.query; placeholder: root.web-mode ? "Explore the web…" : "Describe what you remember…"; horizontal-stretch: 1; accepted => { root.search-now(); } }
                    ActionButton { label: root.search-busy ? "Search again ↗" : "Search  ↗"; primary: true; available: root.query != ""; clicked => { root.search-now(); } }
                }
                HorizontalLayout { height: 38px; spacing: 12px;
                    Text { text: root.search-busy ? "Searching…" : root.search-message; color: root.search-busy ? Atelier.gold : Atelier.muted; font-size: 12px; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
                    if root.web-mode: Rectangle { width: 122px; Text { text: "Open in browser ↗"; color: Atelier.gold; font-size: 11px; vertical-alignment: center; } TouchArea { mouse-cursor: pointer; clicked => { root.open-browser-search(); } } }
                }
                if root.web-mode: Text { text: "Only your search query is sent to DuckDuckGo. Save a source to keep it in your library."; color: Atelier.dim; font-size: 10px; wrap: word-wrap; }
                search-scroll := ScrollView { vertical-stretch: 1;
                    VerticalLayout { width: search-scroll.visible-width; spacing: 12px;
                        if !root.web-mode: VerticalLayout { spacing: 12px; for note in root.search-results: ClassNoteItem { note-text: note.text; date: note.date; can-delete: false; } }
                        if root.web-mode: VerticalLayout { spacing: 12px; for result[index] in root.web-results: Rectangle {
                            height: max(180px, result-snippet.preferred-height + 124px); border-radius: 12px; background: Atelier.surface; border-width: 1px; border-color: Atelier.border;
                            VerticalLayout { padding: 20px; spacing: 10px;
                                Text { text: result.domain; color: Atelier.gold; font-size: 10px; }
                                Text { text: result.title; color: Atelier.ink; font-family: "Georgia"; font-size: 21px; wrap: word-wrap; }
                                result-snippet := Text { text: result.snippet; color: Atelier.muted; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; }
                                HorizontalLayout { spacing: 12px;
                                    ActionButton { label: "Open source ↗"; clicked => { root.open-web-result(index); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton { label: result.saved ? "Saved to queue ✓" : "Save as note  +"; available: !result.saved; primary: !result.saved; clicked => { root.save-web-result(index); } }
                                }
                            }
                        }
                        }
                        if (root.web-mode ? root.web-results.length == 0 : root.search-results.length == 0) && !root.search-busy && root.search-message == "": Rectangle { height: 160px;
                            VerticalLayout { alignment: center; spacing: 10px;
                                Text { text: root.web-mode ? "A world beyond your notes." : "A thought is never far away."; font-family: "Georgia"; font-size: 24px; color: Atelier.ink; horizontal-alignment: center; }
                                Text { text: root.web-mode ? "Search, explore a source, and save what matters." : "Search by meaning, even when the exact words escape you."; font-size: 12px; color: Atelier.muted; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }

            if root.current-page == Page.Settings: SettingsPage { vertical-stretch: 1;
                use-laya <=> root.use-laya; laya-fallback <=> root.laya-fallback;
                llm-model <=> root.llm-model; embeddings-model <=> root.embeddings-model; search-limit <=> root.search-limit;
                classification-web <=> root.classification-web;
                sync-enabled <=> root.sync-enabled; sync-port <=> root.sync-port; sync-running: root.sync-running; sync-status: root.sync-status; sync-devices: root.sync-devices; sync-token: root.sync-token; sync-qr: root.sync-qr; sync-address: root.sync-address;
                llm-running: root.llm-running; llm-status: root.llm-status;
                transfer-status: root.transfer-status;
                import-requested => { root.import-requested(); }
                export-data(kind) => { root.export-data(kind); }
                reset-sync-pairing => { root.reset-sync-pairing(); } save-settings => { root.save-settings(); }
            }
        }
    }

    if root.import-confirmation: Rectangle {
        background: #000000bb;
        TouchArea { }
        Rectangle { width: min(540px,parent.width - 48px); height: 380px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: 16px; background: Atelier.surface; border-width: 1px; border-color: Atelier.border;
            VerticalLayout { padding: 28px; spacing: 20px;
                Eyebrow { text: "BRING YOUR THOUGHTS HOME"; }
                PageHeading { text: "Import this backup?"; font-size: 30px; }
                Text { text: root.import-preview; color: Atelier.muted; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout { spacing: 12px; ActionButton { label: "Cancel"; clicked => { root.import-cancelled(); } } Rectangle { horizontal-stretch: 1; } ActionButton { label: "Import notes ↗"; primary: true; clicked => { root.import-confirmed(); } } }
            }
        }
    }

    if root.notice-visible && !root.alert-visible: Rectangle {
        x: root.width - self.width - 28px; y: root.height - self.height - 24px;
        width: min(460px, root.width - 56px); height: 88px; border-radius: 12px;
        background: #242c23; border-width: 1px; border-color: #69735b;
        drop-shadow-blur: 24px; drop-shadow-color: #00000066;
        HorizontalLayout { padding: 18px; spacing: 14px;
            VerticalLayout { spacing: 5px; horizontal-stretch: 1;
                Text { text: "FILED IN " + root.last-saved-category; color: Atelier.gold; font-size: 10px; overflow: elide; }
                Text { text: root.last-saved-text; color: Atelier.ink; font-size: 12px; overflow: elide; }
            }
            ActionButton { label: "View ↗"; clicked => { root.open-last-note(); } }
            Rectangle { width: 14px; Text { text: "×"; color: Atelier.muted; vertical-alignment: center; } TouchArea { mouse-cursor: pointer; clicked => { root.notice-visible = false; } } }
        }
    }
    if root.alert-visible: Rectangle {
        x: root.width - self.width - 28px; y: root.height - self.height - 24px;
        width: min(500px, root.width - 56px); height: max(72px, error-text.preferred-height + 32px); border-radius: 12px;
        background: root.alert-success ? #1d251e : #352521; border-width: 1px; border-color: root.alert-success ? #344535 : #805c50;
        HorizontalLayout { padding: 16px; spacing: 14px;
            error-text := Text { text: root.alert-message; color: root.alert-success ? Atelier.green : Atelier.red; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
            ActionButton { label: "Dismiss"; clicked => { root.alert-visible = false; } }
        }
    }
}
