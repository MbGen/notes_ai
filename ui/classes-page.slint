import { ScrollView, TextEdit } from "std-widgets.slint";
import { Atelier, ActionButton, Field, Eyebrow, PageHeading } from "atelier.slint";

export struct ClassTileData { name: string, count: string, accent: color, new-count: int }
export struct TileRow { t0: ClassTileData, t1: ClassTileData, t2: ClassTileData, len: int }
export struct NoteData { id: int, text: string, date: string }
export struct WebResultData { title: string, url: string, domain: string, snippet: string, saved: bool }

component ClassTile inherits Rectangle {
    in property <ClassTileData> data;
    callback clicked();
    horizontal-stretch: 1;
    height: 162px;
    border-radius: 14px;
    background: tile-touch.has-hover ? Atelier.raised : Atelier.surface;
    border-width: 1px;
    border-color: tile-touch.has-hover ? #6b624d : Atelier.border;
    animate background { duration: 180ms; }
    tile-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 22px; spacing: 12px;
        HorizontalLayout {
            height: 28px;
            Text { text: "↗"; color: Atelier.gold; font-size: 22px; }
            Rectangle { horizontal-stretch: 1; }
            if root.data.new-count > 0: Rectangle {
                width: max(26px, badge-text.preferred-width + 14px); height: 26px;
                border-radius: 13px; background: Atelier.gold;
                badge-text := Text { text: root.data.new-count > 99 ? "99+" : "\{root.data.new-count}"; color: #24271f; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        Text { text: root.data.name; color: Atelier.ink; font-family: "Georgia"; font-size: 21px; overflow: elide; }
        HorizontalLayout {
            Text { text: root.data.count; color: Atelier.muted; font-size: 11px; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.data.new-count > 0 ? "NEW ARRIVALS" : "COLLECTION"; color: root.data.new-count > 0 ? Atelier.gold : Atelier.dim; font-size: 8px; letter-spacing: 1px; }
        }
    }
}

export component ClassNoteItem inherits Rectangle {
    in property <string> note-text;
    in property <string> date;
    in property <int> index: -1;
    in property <bool> can-delete: true;
    callback delete-note();
    property <bool> expanded: false;
    property <bool> copied: false;
    height: root.expanded ? max(124px, body.preferred-height + 88px) : 124px;
    border-radius: 12px;
    background: Atelier.surface;
    border-width: 1px; border-color: Atelier.border;
    copy-input := TextInput { width: 0; height: 0; text: root.note-text; read-only: true; }
    copy-timer := Timer { interval: 1600ms; triggered => { root.copied = false; self.running = false; } }
    VerticalLayout {
        padding: 18px; spacing: 10px;
        HorizontalLayout {
            height: 18px;
            Text { text: root.date; color: Atelier.gold; font-size: 10px; overflow: elide; horizontal-stretch: 1; }
            Text { text: "NOTE"; color: Atelier.dim; font-size: 9px; letter-spacing: 1px; }
        }
        body := Text { text: root.note-text; color: Atelier.ink; font-size: 14px; wrap: word-wrap; overflow: elide; vertical-stretch: 1; }
        HorizontalLayout {
            height: 20px; spacing: 18px;
            Rectangle { width: 68px; Text { text: root.expanded ? "Collapse ↑" : "Read more ↗"; color: Atelier.muted; font-size: 10px; vertical-alignment: center; } TouchArea { mouse-cursor: pointer; clicked => { root.expanded = !root.expanded; } } }
            Rectangle { width: 44px; Text { text: root.copied ? "Copied" : "Copy"; color: root.copied ? Atelier.green : Atelier.muted; font-size: 10px; vertical-alignment: center; } TouchArea { mouse-cursor: pointer; clicked => { copy-input.select-all(); copy-input.copy(); root.copied = true; copy-timer.running = true; } } }
            Rectangle { horizontal-stretch: 1; }
            if root.can-delete: Rectangle { width: 40px; Text { text: "Delete"; color: Atelier.dim; font-size: 10px; vertical-alignment: center; } TouchArea { mouse-cursor: pointer; clicked => { root.delete-note(); } } }
        }
    }
}

export component ClassesPage inherits Rectangle {
    background: transparent;
    in-out property <[TileRow]> rows;
    in property <int> new-total;
    callback class-selected(string);
    callback on-semantic-search(string);
    VerticalLayout {
        spacing: 22px;
        Eyebrow { text: "YOUR PERSONAL ARCHIVE"; }
        HorizontalLayout {
            PageHeading { text: "Everything in its place."; horizontal-stretch: 1; }
            Text { text: root.new-total > 0 ? "\{root.new-total} new notes" : "All caught up"; color: root.new-total > 0 ? Atelier.gold : Atelier.muted; font-size: 12px; vertical-alignment: center; }
        }
        Text { text: "Thoughtfully organised by AI. Open a collection to explore what is new."; color: Atelier.muted; font-size: 13px; }
        if root.rows.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout { alignment: center; spacing: 14px;
                Text { text: "Your library starts with a thought."; font-family: "Georgia"; font-size: 26px; color: Atelier.ink; horizontal-alignment: center; }
                Text { text: "Capture your first note. AI will create its collection here."; color: Atelier.muted; font-size: 13px; horizontal-alignment: center; }
            }
        }
        if root.rows.length > 0: grid-scroll := ScrollView {
            vertical-stretch: 1;
            VerticalLayout { width: grid-scroll.visible-width; spacing: 14px;
                for row in root.rows: HorizontalLayout { spacing: 14px;
                    if row.len >= 1: ClassTile { data: row.t0; clicked => { root.class-selected(row.t0.name); } }
                    if row.len >= 2: ClassTile { data: row.t1; clicked => { root.class-selected(row.t1.name); } }
                    if row.len >= 3: ClassTile { data: row.t2; clicked => { root.class-selected(row.t2.name); } }
                    if row.len < 3: Rectangle { horizontal-stretch: 1; }
                    if row.len < 2: Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

export component ClassNotesPage inherits Rectangle {
    in property <bool> newest-first: true;
    callback sort-notes();
    in property <string> class-name;
    in-out property <[NoteData]> notes;
    callback go-back();
    callback delete-note(int);
    callback add-note(string);
    callback delete-class(string);
    callback rename-class(string);
    in-out property <string> draft;
    property <bool> editing-name: false;
    property <bool> confirm-delete: false;
    VerticalLayout {
        spacing: 18px;
        HorizontalLayout { height: 26px;
            Rectangle { width: 130px; Text { text: "←  Back to library"; color: Atelier.muted; font-size: 12px; vertical-alignment: center; } TouchArea { mouse-cursor: pointer; clicked => { root.go-back(); } } }
            Rectangle { horizontal-stretch: 1; }
            Eyebrow { text: "COLLECTION"; vertical-alignment: center; }
        }
        HorizontalLayout { spacing: 12px;
            if !root.editing-name: PageHeading { text: root.class-name; overflow: elide; horizontal-stretch: 1; }
            if root.editing-name: Field { text: root.class-name; horizontal-stretch: 1; accepted => { if self.text != "" { root.rename-class(self.text); root.editing-name = false; } } }
            ActionButton { label: root.editing-name ? "Cancel" : "Rename"; clicked => { root.editing-name = !root.editing-name; } }
            ActionButton { label: "Delete collection"; danger: true; clicked => { root.confirm-delete = true; } }
        }
        HorizontalLayout { spacing: 12px;
            Text { text: "\{root.notes.length} notes  ·  Saved on this PC"; color: Atelier.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
            ActionButton { label: root.newest-first ? "Date ↓  Newest first" : "Date ↑  Oldest first"; clicked => { root.sort-notes(); } }
        }
        detail-scroll := ScrollView {
            vertical-stretch: 1;
            VerticalLayout { width: detail-scroll.visible-width; spacing: 10px;
                for note in root.notes: ClassNoteItem { note-text: note.text; date: note.date; index: note.id; delete-note => { root.delete-note(note.id); } }
                if root.notes.length == 0: Text { text: "A little room for your next idea."; color: Atelier.muted; font-size: 15px; }
            }
        }
        HorizontalLayout { spacing: 12px;
            entry := Field { text <=> root.draft; horizontal-stretch: 1; placeholder: "Add directly to this collection…"; accepted => { if self.text != "" { root.add-note(self.text); } } }
            ActionButton { label: "Add note  +"; primary: true; clicked => { if entry.text != "" { root.add-note(entry.text); } } }
        }
    }
    if root.confirm-delete: Rectangle {
        background: #000000b0;
        Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: min(460px, parent.width - 20px); height: 220px; border-radius: 16px; background: Atelier.surface; border-width: 1px; border-color: Atelier.border;
            VerticalLayout { padding: 26px; spacing: 18px;
                Text { text: "Delete this collection?"; font-family: "Georgia"; font-size: 25px; color: Atelier.ink; }
                Text { text: "All notes in this collection will be deleted from the PC and the next phone snapshot."; color: Atelier.muted; wrap: word-wrap; font-size: 13px; }
                HorizontalLayout { spacing: 12px; ActionButton { label: "Keep collection"; clicked => { root.confirm-delete = false; } } ActionButton { label: "Delete collection"; danger: true; clicked => { root.confirm-delete = false; root.delete-class(root.class-name); } } }
            }
        }
    }
}
